{
  "name": "claude-cli-channel",
  "version": "0.1.0",
  "description": "Local Claude Code channel for sending messages from Codex or a shell into a live Claude Code session.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    ".claude-plugin",
    ".codex-plugin",
    ".mcp.json",
    ".mcp.example.json",
    "skills",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "bin": {
    "claude-channel": "./dist/cli.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && node ./scripts/make-cli-executable.mjs",
    "dev:channel": "tsx ./src/channel.ts",
    "channel": "node ./dist/channel.js",
    "codex-mcp": "node ./dist/codex-mcp.js",
    "send": "node ./dist/cli.js send",
    "status": "node ./dist/cli.js status",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run typecheck:test && npm test",
    "validate:plugin": "claude plugin validate . --strict",
    "check:local": "npm run check && npm audit --audit-level=moderate && npm run validate:plugin && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  }
}
