{
  "name": "claude-channel-cli",
  "version": "0.2.0",
  "description": "Local Claude Code channel CLI for asking a live Claude Code session and receiving replies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronn/claude-channel-cli.git"
  },
  "bugs": {
    "url": "https://github.com/aaronn/claude-channel-cli/issues"
  },
  "homepage": "https://github.com/aaronn/claude-channel-cli#readme",
  "type": "module",
  "files": [
    "dist",
    ".claude-plugin",
    ".codex-plugin",
    "assets",
    ".mcp.json",
    ".mcp.example.json",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "claude-channel": "dist/cli.js",
    "claude-channel-server": "dist/channel.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && node ./scripts/make-cli-executable.mjs",
    "dev:channel": "tsx ./src/channel.ts",
    "channel": "node ./dist/channel.js",
    "codex-mcp": "node ./dist/codex-mcp.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:e2e": "npm run build && node --import tsx --test test/**/*.e2e.ts",
    "check:version": "node ./scripts/check-version.mjs",
    "check": "npm run check:version && npm run lint && npm run typecheck && npm run typecheck:test && npm test && npm run test:e2e",
    "validate:plugin": "claude plugin validate . --strict",
    "check:local": "npm run check && npm audit --audit-level=moderate && npm run validate:plugin && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "undici": "^7.27.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  }
}
